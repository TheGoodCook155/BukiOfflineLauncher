<Window x:Class="BukiOffline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BukiOffline"
        xmlns:converters="clr-namespace:BukiOffline.Converters"
        mc:Ignorable="d"
        Title="Буки Offline" MaxWidth="500" MaxHeight="380" Height="380" Width="500">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="40">
        <StackPanel >
            <StackPanel Orientation="Horizontal" >
                <Label Content="Одбери CPU или GPU"/>
                <ComboBox Width="200" 
                            SelectedValue="{Binding CpuGpuComboBoxSelectedValue}"
                            SelectedValuePath="Content">
                    <ComboBoxItem>CPU</ComboBoxItem>
                    <ComboBoxItem>GPU</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding DownloadMessage}" Visibility="{Binding DownloadingProjectVisibility, Converter={StaticResource BoolToVisibilityConverter}}" MinWidth="120" Width="180"/>
                <Label Content="{Binding DownloadPercent}" Visibility="{Binding DownloadingProjectVisibility, Converter={StaticResource BoolToVisibilityConverter}}" MinWidth="100"/>
            </StackPanel>

            <Label Content="{Binding UnzipMessage}" Visibility="{Binding ExtractProjectVisibility, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Label Content="{Binding CheckingDependenciesMessage}" Visibility="{Binding CheckingDependenciesVisibility, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Width="150" Margin="20" Content="Restart" Command="{Binding RestartApp}"/>
        </StackPanel>
    </Grid>
</Window>
